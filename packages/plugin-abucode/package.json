{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin-abucode",
  "version": "2.2.5",
  "description": "ABuCode built-in Household, Provider Vault, Archiver, Memory, Security, and Playtest plugin",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./security": "./src/security.ts",
    "./providers": "./src/providers.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.19",
    "@opencode/ai": "workspace:*",
    "@opencode/plugin": "workspace:*",
    "@opencode/schema": "workspace:*",
    "@opencode/util": "workspace:*",
    "@playwright/test": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
